{
  "package": "ALBA_Step9_ClosedLoop_v2",
  "version": "v2",
  "created": "2026-09-02",
  "baseline": "ALBA_Step9_ClosedLoop_v1, preserved unchanged and not superseded",
  "stage_A": "program and statistics fixes only; control parameters identical to v1",
  "stage_B": "the same controller on the full five-state reference model; no retuning",
  "stage_C": "termination-strategy optimisation NOT run in this package",
  "model_reidentified": false,
  "basis_terms_added": false,
  "Rh_re_verified": false,
  "Rh_note": "bench effective resistance, used exactly as documented; never adjusted to improve a curve",
  "integer_to_double_fix_retained": true,
  "experimental_validation": false,
  "measurement_noise_in_loop": false,
  "controller_qualified": false,
  "torque_envelope_note": "0.29658517619749203 N*m is a CONDITIONAL FLAT ENVELOPE, not a measured 12 V running-torque curve. 0.67 A is an assumed current. Peak utilisation reached 98.0 percent, so 15 mL/s is treated as a near-limit design case and is NOT declared feasible.",
  "volume_error_note": "The final volume error is bookkeeping only: an ideal volume event closes the valve and the delivered tail equals the compensated tail.",
  "environment": {
    "MATLAB": "R2025a Update 1 (25.1.0.2973910)",
    "Simulink": "25.1",
    "Python": "3.13.9 with numpy 2.3.5 / scipy 1.16.3 (only to re-dump reference_points.json)",
    "solver_A": "ode15s, RelTol 2e-8, MaxStep 0.025; tightened re-check at RelTol 1e-10, MaxStep 0.0125",
    "solver_B": "ode15s, RelTol 2e-8, AbsTol 1e-9, MaxStep 0.025, per-state absolute tolerances",
    "os": "Windows 11 Pro 26200"
  },
  "reproduce": [
    "matlab -batch \"cd('<package>'); rebuild_all()\"",
    "optional, needs the Stage-8 Python package:",
